{
  "name": "dsh-tr-bridge",
  "version": "0.2.0",
  "description": "Native TR Codex model provider plus the existing TokenRouter CLI bridge for DeepSeek Harness. Uses the existing tr login and does not ask for an API key.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "resolve-tr.js",
    "models.js",
    "config-api.js",
    "llm/*.js",
    "docs/*.md",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "LICENSE",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "compatibility.json"
  ],
  "icon": "./icon.svg",
  "scripts": { "test": "node --test test/bridge.test.js test/resolve-tr.test.js test/models.test.js test/config-api.test.js test/client.test.js test/llm-rpc.test.js test/llm-catalog.test.js test/llm-adapter.test.js test/llm-transport.test.js test/llm-contract.test.js" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superqin7/dsh-tr-bridge.git"
  },
  "keywords": ["deepseek-harness", "dsh-plugin", "tokenrouter", "codex-cli", "grok-cli", "windows"],
  "engines": { "node": ">=20" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
